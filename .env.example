# Copy to .env.local and fill in before enabling persistence / AI.
# Until these are set, the app runs on the local (in-browser) data layer
# and a local heuristic recommender. See /docs/technical.md and
# /docs/architecture.md for what each of these unlocks.

# Supabase Postgres connection string (enables Prisma persistence).
DATABASE_URL=

# Supabase project (enables auth + storage for photo captures).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Enables real AI-generated recommendations instead of the local fallback.
OPENAI_API_KEY=

# Base URL of a running Atlas API, no trailing slash and no /api suffix.
# THE one place Atlas is configured: Discovery, the curator workbench and every
# /api/admin/* proxy read it (src/lib/data/atlasAuth.ts). Unset falls back to
# http://localhost:3000, which is only right on a developer machine.
ATLAS_API_URL=

# Passport's identity to Atlas (Authorization: Bearer ...). Server-only.
ATLAS_SERVICE_TOKEN=

# --- Curator workbench (/admin, /explorer, /api/admin/*) -------------------
# See docs/admin-workbench.md. All server-only: never prefix with NEXT_PUBLIC_.
#
# What Atlas accepts for corpus-changing calls (its x-admin-token). Attached on
# the server after the caller has been proven an administrator.
ADMIN_TOKEN=
# Who may use the workbench: comma-separated email addresses of Supabase
# accounts. Matched case-insensitively against a VERIFIED email. Empty or unset
# means nobody (closed, not open).
ADMIN_EMAILS=
