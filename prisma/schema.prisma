// Reference schema for the documented architecture (see /docs/architecture.md).
// Adventure DNA and Today's Intent are explicitly non-final in the Product
// Brain (see /09-curation-framework.md), so their shapes are kept as flexible
// JSON rather than fixed columns until the founder confirms the model.
//
// Not yet connected to a live database — no DATABASE_URL is configured.
// The app currently runs on the local data layer in src/lib/data (see
// /docs/architecture.md, "Data layer"). Run `npx prisma migrate dev` once a
// Supabase Postgres connection string is available in .env.local.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())

  adventureDna AdventureDna?
  adventures   Adventure[]
}

model AdventureDna {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  // Long-term preferences (loves water, foodie, budget conscious, ...).
  // Kept as JSON — see note at top of file.
  traits    Json
  updatedAt DateTime @updatedAt
}

model Adventure {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  // Captured at Plan time.
  intent      String
  constraints Json

  // Produced by the recommendation step (Curate My Day).
  title    String
  tagline  String
  blocks   Json

  status   String   @default("planned") // planned | active | completed
  moments  Moment[]
}

model Moment {
  id          String    @id @default(uuid())
  adventureId String
  adventure   Adventure @relation(fields: [adventureId], references: [id])
  createdAt   DateTime  @default(now())

  note      String?
  photoUrl  String?
}
